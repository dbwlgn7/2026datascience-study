import streamlit as st
import pandas as pd
import plotly.express as px

st.set_page_config(page_title="뇌졸중 예측 실습실 - 탐색", page_icon="📊", layout="wide")
st.title("📊 데이터 탐색")
st.markdown("---")

# 데이터 로드
@st.cache_data
def load_data():
    url = "https://raw.githubusercontent.com/greatsong/modudata/main/data/stroke.csv"
    df = pd.read_csv(url, encoding="utf-8")
    # stroke 값을 시각화를 위해 문자열로 변환한 열 추가
    df['stroke_str'] = df['stroke'].apply(lambda x: '발생' if x == 1 else '미발생')
    df['hypertension_str'] = df['hypertension'].apply(lambda x: '있음' if x == 1 else '없음')
    df['heart_disease_str'] = df['heart_disease'].apply(lambda x: '있음' if x == 1 else '없음')
    return df

df = load_data()

# 1. 나이와 평균 혈당 분포 (히스토그램)
st.subheader("1. 나이와 평균 혈당 분포")
col1, col2 = st.columns(2)

with col1:
    fig_age = px.histogram(df, x='age', title='나이(Age) 분포', nbins=30, color_discrete_sequence=['#636EFA'])
    st.plotly_chart(fig_age, use_container_width=True)

with col2:
    fig_glucose = px.histogram(df, x='avg_glucose_level', title='평균 혈당(Avg Glucose Level) 분포', nbins=30, color_discrete_sequence=['#EF553B'])
    st.plotly_chart(fig_glucose, use_container_width=True)

st.markdown("---")

# 2. 뇌졸중 여부에 따른 나이 및 평균 혈당 비교 (상자그림 및 표)
st.subheader("2. 뇌졸중 여부에 따른 나이 및 평균 혈당 비교")
col3, col4 = st.columns(2)

with col3:
    fig_box_age = px.box(df, x='stroke_str', y='age', color='stroke_str', title='뇌졸중 여부에 따른 나이 분포', labels={'stroke_str': '뇌졸중 여부', 'age': '나이'})
    st.plotly_chart(fig_box_age, use_container_width=True)

with col4:
    fig_box_glucose = px.box(df, x='stroke_str', y='avg_glucose_level', color='stroke_str', title='뇌졸중 여부에 따른 평균 혈당 분포', labels={'stroke_str': '뇌졸중 여부', 'avg_glucose_level': '평균 혈당'})
    st.plotly_chart(fig_box_glucose, use_container_width=True)

# 평균값 표
st.write("📌 **뇌졸중 여부에 따른 평균값**")
mean_df = df.groupby('stroke_str')[['age', 'avg_glucose_level']].mean().reset_index()
mean_df.columns = ['뇌졸중 여부', '평균 나이', '평균 혈당']
st.dataframe(mean_df, hide_index=True)

st.markdown("---")

# 3. 고혈압/심장병 여부에 따른 뇌졸중 비율 (막대그래프)
st.subheader("3. 질환 여부에 따른 뇌졸중 발생 비율")
col5, col6 = st.columns(2)

# 고혈압 비율 계산
hyper_ratio = df.groupby('hypertension_str')['stroke'].mean().reset_index()
hyper_ratio['stroke'] = hyper_ratio['stroke'] * 100
hyper_ratio.columns = ['고혈압 여부', '뇌졸중 비율(%)']

with col5:
    fig_hyper = px.bar(hyper_ratio, x='고혈압 여부', y='뇌졸중 비율(%)', color='고혈압 여부', title='고혈압 여부에 따른 뇌졸중 비율', text_auto='.2f')
    st.plotly_chart(fig_hyper, use_container_width=True)

# 심장병 비율 계산
heart_ratio = df.groupby('heart_disease_str')['stroke'].mean().reset_index()
heart_ratio['stroke'] = heart_ratio['stroke'] * 100
heart_ratio.columns = ['심장병 여부', '뇌졸중 비율(%)']

with col6:
    fig_heart = px.bar(heart_ratio, x='심장병 여부', y='뇌졸중 비율(%)', color='심장병 여부', title='심장병 여부에 따른 뇌졸중 비율', text_auto='.2f')
    st.plotly_chart(fig_heart, use_container_width=True)

st.markdown("---")

# 4. BMI 결측치(빈 값) 분석
st.subheader("4. BMI 결측치 분석")

bmi_null_df = df[df['bmi'].isnull()]
bmi_null_count = len(bmi_null_df)

total_stroke_ratio = df['stroke'].mean() * 100
null_bmi_stroke_ratio = bmi_null_df['stroke'].mean() * 100 if bmi_null_count > 0 else 0

st.write(f"BMI 값이 비어 있는 사람은 총 **{bmi_null_count}명** 입니다.")

bmi_compare_df = pd.DataFrame({
    '구분': ['전체', 'BMI 빈 값인 사람'],
    '뇌졸중 비율(%)': [total_stroke_ratio, null_bmi_stroke_ratio]
})

st.dataframe(bmi_compare_df, hide_index=True)

st.markdown("---")

# 5. 흡연 상태별 인원수 표
st.subheader("5. 흡연 상태별 인원수")

smoke_counts = df['smoking_status'].value_counts().reset_index()
smoke_counts.columns = ['흡연 상태', '사람 수']
st.dataframe(smoke_counts, hide_index=True)
